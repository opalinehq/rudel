# Opaline CLI environment variables

# Print debug diagnostics for every command to stderr.
# OPALINE_LOG_LEVEL=debug

# Override the API base. Production defaults to https://opaline.so.
# OPALINE_API_BASE=http://localhost:4010

# Override the local state directory. By default Opaline intentionally keeps
# using ~/.rudel so existing credentials, failed-upload queues, hooks, and cron
# jobs continue without migration. RUDEL_CONFIG_DIR remains supported.
# OPALINE_CONFIG_DIR=/absolute/path/to/opaline-state

# Permit plaintext HTTP for login/auth traffic to a non-loopback host.
# This sends access credentials without transport encryption.
# OPALINE_ALLOW_INSECURE_API_BASE=1

# Permit plaintext HTTP for transcript uploads to a non-loopback host.
# This sends transcript data and API credentials without transport encryption.
# OPALINE_ALLOW_INSECURE_ENDPOINT=1

# Optional product analytics. Disabled unless explicitly enabled and configured.
# POSTHOG_ENABLED=false
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Compatibility aliases accepted by the renamed CLI:
# RUDEL_API_BASE=
# RUDEL_CONFIG_DIR=
# RUDEL_ALLOW_INSECURE_API_BASE=
# RUDEL_ALLOW_INSECURE_ENDPOINT=
